<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Team Together Oman 7A - Interactive</title>

<style>
*{box-sizing:border-box}

body{
margin:0;
font-family:Arial,sans-serif;
background:#f4f7fb;
color:#24324a;
}

header{
background:linear-gradient(135deg,#2457a6,#7042b8);
color:white;
text-align:center;
padding:35px 15px;
}

header h1{
margin:0;
font-size:32px;
}

header p{
font-size:17px;
margin:10px 0 0;
}

nav{
background:white;
padding:12px;
display:flex;
justify-content:center;
gap:8px;
flex-wrap:wrap;
box-shadow:0 2px 10px rgba(0,0,0,.1);
position:sticky;
top:0;
z-index:10;
}

nav button{
border:0;
background:#edf2ff;
color:#2457a6;
padding:11px 17px;
border-radius:20px;
font-weight:bold;
cursor:pointer;
}

nav button:hover{
background:#2457a6;
color:white;
}

.container{
max-width:1100px;
margin:auto;
padding:25px 15px 50px;
}

.page{
display:none;
}

.page.active{
display:block;
}

.hero{
background:white;
border-radius:20px;
padding:35px 20px;
text-align:center;
box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.hero h2{
color:#2457a6;
font-size:28px;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:18px;
margin-top:22px;
}

.card{
background:white;
padding:25px;
border-radius:18px;
box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.card h3{
color:#7042b8;
}

.action{
background:#2457a6;
color:white;
border:0;
padding:12px 20px;
border-radius:10px;
cursor:pointer;
font-weight:bold;
}

.action:hover{
background:#193f7b;
}

.unit{
background:white;
padding:25px;
margin-top:20px;
border-radius:20px;
box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.unit h2{
color:#2457a6;
}

.lesson{
background:#f7f9ff;
border-left:6px solid #7042b8;
padding:20px;
margin:15px 0;
border-radius:10px;
}

.word-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
gap:12px;
}

.word{
background:white;
border:2px solid #dce5ff;
border-radius:12px;
padding:15px;
text-align:center;
font-weight:bold;
cursor:pointer;
}

.word:hover{
background:#edf2ff;
transform:translateY(-2px);
}

.activity{
background:white;
padding:25px;
margin-top:20px;
border-radius:18px;
box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.activity h3{
color:#2457a6;
}

.option{
display:block;
width:100%;
padding:12px;
margin:8px 0;
border:1px solid #ccd7ef;
border-radius:10px;
background:white;
text-align:left;
cursor:pointer;
}

.option:hover{
background:#edf2ff;
}

.correct{
background:#c9f7d5!important;
}

.wrong{
background:#ffd1d1!important;
}

.score{
font-weight:bold;
font-size:19px;
margin-top:15px;
}

input,textarea{
width:100%;
padding:12px;
margin:7px 0;
border:1px solid #ccd7ef;
border-radius:10px;
font-family:Arial;
}

textarea{
min-height:130px;
}

footer{
background:#202b43;
color:white;
text-align:center;
padding:20px;
}

@media(max-width:600px){
header h1{font-size:24px}
.hero,.unit,.activity{padding:18px}
}
</style>
</head>

<body>

<header>
<h1>Team Together Oman 7A</h1>
<p>Interactive English Learning Website</p>
</header>

<nav>
<button onclick="showPage('home')">🏠 Home</button>
<button onclick="showPage('units')">📚 Units</button>
<button onclick="showPage('vocabulary')">🧠 Vocabulary</button>
<button onclick="showPage('grammar')">✏️ Grammar</button>
<button onclick="showPage('games')">🎮 Games</button>
<button onclick="showPage('practice')">📝 Practice</button>
</nav>

<div class="container">

<section id="home" class="page active">

<div class="hero">
<h2>Welcome to Team Together Oman 7A!</h2>
<p>Interactive English learning for Grade 7 students.</p>
<p>Choose a section and start learning!</p>
</div>

<div class="cards">

<div class="card">
<h3>📚 Units</h3>
<p>Explore the English course units and lessons.</p>
<button class="action" onclick="showPage('units')">Explore</button>
</div>

<div class="card">
<h3>🧠 Vocabulary</h3>
<p>Learn and practise new English words.</p>
<button class="action" onclick="showPage('vocabulary')">Practise</button>
</div>

<div class="card">
<h3>✏️ Grammar</h3>
<p>Practise English grammar interactively.</p>
<button class="action" onclick="showPage('grammar')">Grammar</button>
</div>

<div class="card">
<h3>🎮 Games</h3>
<p>Learn English through fun games.</p>
<button class="action" onclick="showPage('games')">Play</button>
</div>

</div>
</section>


<section id="units" class="page">

<div class="hero">
<h2>📚 Grade 7A Units</h2>
<p>Team Together Oman – Grade 7A</p>
</div>

<div class="unit">

<h2>Unit 1 – Entertainment</h2>

<div class="lesson">

<h3>Lesson 1 – Jobs in Entertainment</h3>

<p>Learn vocabulary about different jobs in the entertainment industry.</p>

<div class="word-grid">

<div class="word" onclick="speak('presenter')">🎤 Presenter</div>

<div class="word" onclick="speak('performer')">🎭 Performer</div>

<div class="word" onclick="speak('comedian')">😂 Comedian</div>

<div class="word" onclick="speak('clown')">🤡 Clown</div>

<div class="word" onclick="speak('puppeteer')">🧸 Puppeteer</div>

<div class="word" onclick="speak('sound editor')">🎧 Sound editor</div>

<div class="word" onclick="speak('stunt performer')">🎬 Stunt performer</div>

<div class="word" onclick="speak('animator')">🎨 Animator</div>

<div class="word" onclick="speak('writer')">✍️ Writer</div>

<div class="word" onclick="speak('costume designer')">👗 Costume designer</div>

<div class="word" onclick="speak('make-up artist')">💄 Make-up artist</div>

<div class="word" onclick="speak('camera operator')">📹 Camera operator</div>

</div>

</div>

<div class="lesson">
<h3>Lesson 2</h3>
<p>Continue learning and practising English through the entertainment topic.</p>
</div>

</div>

<div class="unit">

<h2>More Units</h2>

<div class="cards">

<div class="card">
<h3>Unit 2</h3>
<p>Lessons and interactive activities.</p>
</div>

<div class="card">
<h3>Unit 3</h3>
<p>Lessons and interactive activities.</p>
</div>

<div class="card">
<h3>Unit 4</h3>
<p>Lessons and interactive activities.</p>
</div>

</div>

</div>

</section>


<section id="vocabulary" class="page">

<div class="hero">
<h2>🧠 Vocabulary</h2>
<p>Click any word to hear it.</p>
</div>

<div class="activity">

<h3>Entertainment Jobs</h3>

<div class="word-grid">

<div class="word" onclick="speak('presenter')">Presenter</div>
<div class="word" onclick="speak('performer')">Performer</div>
<div class="word" onclick="speak('comedian')">Comedian</div>
<div class="word" onclick="speak('clown')">Clown</div>
<div class="word" onclick="speak('puppeteer')">Puppeteer</div>
<div class="word" onclick="speak('sound editor')">Sound editor</div>
<div class="word" onclick="speak('stunt performer')">Stunt performer</div>
<div class="word" onclick="speak('animator')">Animator</div>
<div class="word" onclick="speak('writer')">Writer</div>
<div class="word" onclick="speak('costume designer')">Costume designer</div>
<div class="word" onclick="speak('make-up artist')">Make-up artist</div>
<div class="word" onclick="speak('camera operator')">Camera operator</div>

</div>

</div>

<div class="activity">

<h3>🎯 Match the Description</h3>

<p>Who makes people laugh?</p>

<button class="option" onclick="check(this,true)">Comedian</button>
<button class="option" onclick="check(this,false)">Writer</button>
<button class="option" onclick="check(this,false)">Presenter</button>

<p>Who operates a camera?</p>

<button class="option" onclick="check(this,true)">Camera operator</button>
<button class="option" onclick="check(this,false)">Clown</button>
<button class="option" onclick="check(this,false)">Animator</button>

<p>Who designs clothes?</p>

<button class="option" onclick="check(this,true)">Costume designer</button>
<button class="option" onclick="check(this,false)">Comedian</button>
<button class="option" onclick="check(this,false)">Writer</button>

</div>

</section>


<section id="grammar" class="page">

<div class="hero">
<h2>✏️ Grammar Challenge</h2>
<p>Choose the correct answer.</p>
</div>

<div class="activity">

<p><strong>1.</strong> She _____ TV every evening.</p>

<button class="option" onclick="check(this,false)">watch</button>
<button class="option" onclick="check(this,true)">watches</button>
<button class="option" onclick="check(this,false)">watching</button>

<p><strong>2.</strong> They _____ to the cinema yesterday.</p>

<button class="option" onclick="check(this,true)">went</button>
<button class="option" onclick="check(this,false)">go</button>
<button class="option" onclick="check(this,false)">going</button>

<p><strong>3.</strong> He is _____ a film now.</p>

<button class="option" onclick="check(this,true)">watching</button>
<button class="option" onclick="check(this,false)">watch</button>
<button class="option" onclick="check(this,false)">watched</button>

</div>

</section>


<section id="games" class="page">

<div class="hero">
<h2>🎮 Games</h2>
<p>Test your English!</p>
</div>

<div class="activity">

<h3>🎯 Guess the Job</h3>

<p id="clue">I make people laugh.</p>

<button class="option" onclick="guess(this,'Comedian')">Comedian</button>
<button class="option" onclick="guess(this,'Writer')">Writer</button>
<button class="option" onclick="guess(this,'Presenter')">Presenter</button>

<div id="result" class="score"></div>

<button class="action" onclick="newQuestion()">Next Question</button>

</div>

<div class="activity">

<h3>🔤 Build the Sentence</h3>

<p>Click the words in the correct order.</p>

<div class="word-grid">

<div class="word" onclick="add('She')">She</div>
<div class="word" onclick="add('is')">is</div>
<div class="word" onclick="add('a')">a</div>
<div class="word" onclick="add('presenter')">presenter</div>

</div>

<p><strong>Your sentence:</strong></p>

<div id="sentence"
style="padding:15px;border:2px dashed #ccd7ef;border-radius:10px;min-height:50px">
</div>

<br>

<button class="action" onclick="checkSentence()">Check</button>

<button class="action" onclick="clearSentence()">Clear</button>

<div id="sentenceResult" class="score"></div>

</div>

</section>


<section id="practice" class="page">

<div class="hero">

<h2>📝 Practice Zone</h2>

<p>Write and practise your English.</p>

</div>

<div class="activity">

<h3>✍️ Writing Practice</h3>

<p>Choose an entertainment job and describe it.</p>

<input id="job" placeholder="Entertainment job">

<textarea id="writing"
placeholder="Write 2–3 sentences..."></textarea>

<button class="action" onclick="saveWriting()">Check My Writing</button>

<div id="writingResult" class="score"></div>

</div>

<div class="activity">

<h3>💬 Speaking Practice</h3>

<p>Answer these questions aloud:</p>

<p>What kind of entertainment do you enjoy?</p>

<p>What is your favourite TV programme?</p>

<p>Which entertainment job would you like to do?</p>

<button class="action"
onclick="speak('Which entertainment job would you like to do?')">
🔊 Hear Question
</button>

</div>

</section>

</div>


<footer>

<p>Team Together Oman 7A</p>
<p>Interactive English Learning Website</p>

</footer>


<script>

function showPage(id){

document.querySelectorAll('.page')
.forEach(page=>page.classList.remove('active'));

document.getElementById(id)
.classList.add('active');

window.scrollTo(0,0);

}


function speak(text){

if('speechSynthesis' in window){

speechSynthesis.cancel();

let voice=new SpeechSynthesisUtterance(text);

voice.lang='en-GB';

voice.rate=.8;

speechSynthesis.speak(voice);

}

}


function check(button,correct){

if(correct){

button.classList.add('correct');

button.textContent='✓ '+button.textContent;

}else{

button.classList.add('wrong');

}

}


const questions=[

['I write stories and scripts.','Writer'],

['I operate a camera.','Camera operator'],

['I design clothes for performers.','Costume designer'],

['I present programmes.','Presenter']

];

let q=0;


function guess(button,answer){

if(answer===questions[q][1]){

button.classList.add('correct');

document.getElementById('result').textContent='🎉 Correct!';

}else{

button.classList.add('wrong');

document.getElementById('result').textContent='❌ Try again!';

}

}


function newQuestion(){

q++;

if(q>=questions.length){

q=0;

}

document.getElementById('clue').textContent=questions[q][0];

document.getElementById('result').textContent='';

document.querySelectorAll('#games .option')
.forEach(b=>b.classList.remove('correct','wrong'));

}


let sentenceWords=[];


function add(word){

sentenceWords.push(word);

document.getElementById('sentence')
.textContent=sentenceWords.join(' ');

}


function checkSentence(){

if(sentenceWords.join(' ')==='She is a presenter'){

document.getElementById('sentenceResult').textContent='🎉 Excellent!';

}else{

document.getElementById('sentenceResult').textContent='❌ Try again.';

}

}


function clearSentence(){

sentenceWords=[];

document.getElementById('sentence').textContent='';

document.getElementById('sentenceResult').textContent='';

}


function saveWriting(){

let job=document.getElementById('job').value.trim();

let writing=document.getElementById('writing').value.trim();

if(job && writing){

document.getElementById('writingResult').textContent=
'✓ Great! Your writing is ready.';

}else{

document.getElementById('writingResult').textContent=
'Please complete both boxes.';

}

}

</script>

</body>
</html>
